<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_grap"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.abarrotesrosi.presentation.oauth.ui.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.abarrotesrosi.presentation.oauth.ui.RegisterFragment"
        android:label="fragment_register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.abarrotesrosi.presentation.oauth.ui.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_homeFragment_to_DataFragment"
            app:destination="@id/DataFragment" />
        <action
            android:id="@+id/action_homeFragment_to_ViewProductsFragment"
            app:destination="@id/ViewProductsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_veiwBuyFragment"
            app:destination="@id/veiwBuyFragment" />
    </fragment>

    <fragment
        android:id="@+id/DataFragment"
        android:name="com.example.abarrotesrosi.presentation.oauth.ui.DataFragment"
        android:label="fragment_data"
        tools:layout="@layout/fragment_data">

        <action
            android:id="@+id/action_DataFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_DataFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_DataFragment_to_ViewProductsFragment"
            app:destination="@id/ViewProductsFragment" />

    </fragment>

    <fragment
        android:id="@+id/ViewProductsFragment"
        android:name="com.example.abarrotesrosi.presentation.oauth.ui.ViewProductsFragment"
        android:label="fragment_viewproducts"
        tools:layout="@layout/fragment_viewproducts" >
        <action
            android:id="@+id/action_ViewProductsFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_ViewProductsFragment_to_DataFragment"
            app:destination="@id/DataFragment" />
        <action
            android:id="@+id/action_ViewProductsFragment_to_ProductsFragment"
            app:destination="@id/ProductsFragment" />
    </fragment>

    <fragment
        android:id="@+id/ProductsFragment"
        android:name="com.example.abarrotesrosi.presentation.oauth.ui.ProductsFragment"
        android:label="fragment_products"
        tools:layout="@layout/fragment_products" >
        <action
            android:id="@+id/action_ProductsFragment_to_ViewProductsFragment"
            app:destination="@id/ViewProductsFragment" />
    </fragment>
    <fragment
        android:id="@+id/editProductsFragment"
        android:name="com.example.abarrotesrosi.presentation.oauth.ui.EditProductsFragment"
        android:label="Editar Producto"
        tools:layout="@layout/fragment_editproduc" />
    <action
        android:id="@+id/action_ViewProductsFragment_to_editProductsFragment"
        app:destination="@id/editProductsFragment" />
    <fragment
        android:id="@+id/veiwBuyFragment"
        android:name="com.example.abarrotesrosi.presentation.oauth.ui.VeiwBuyFragment"
        android:label="Resumen de compra"
        tools:layout="@layout/fragment_vewbuy" />
</navigation>